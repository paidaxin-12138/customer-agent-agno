# Customer-Agent 环境变量配置
# 复制此文件为 .env 并填入实际值（.env 已在 .gitignore，勿提交）

# LLM 配置（优先于 config.json 中的 llm.*）
LLM_MODEL_NAME=qwen-turbo
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.5

# 消息消费者并发（chat.message_consumer_max_concurrent）
MESSAGE_CONSUMER_MAX_CONCURRENT=16

# AI 专用覆盖（chat.ai_max_tokens / chat.ai_temperature，可选）
# CHAT_AI_MAX_TOKENS=500
# CHAT_AI_TEMPERATURE=0.5
# CHAT_KNOWLEDGE_RETRIEVAL_TIMEOUT_SEC=5

# Embedder 配置
EMBEDDER_MODEL_NAME=text-embedding-v4
EMBEDDER_API_KEY=your-api-key-here
EMBEDDER_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 知识库配置
KNOWLEDGE_CONTENTS_DB_PATH=./Agent/CustomerAgent/knowledge
KNOWLEDGE_VECTOR_DB_PATH=./vector_db

# 数据库配置
DB_PATH=./data/customer_agent.db

# 拼多多开放平台（可选）
PDD_OPEN_CLIENT_ID=your-client-id-here
PDD_OPEN_CLIENT_SECRET=your-client-secret-here
PDD_OPEN_ACCESS_TOKEN=your-access-token-here

# 账号 Cookie/密码加密（推荐生产环境设置）
# AGENT_CREDENTIAL_KEY=your-long-random-secret

# 健康检查 Token（/ready、/metrics 探活必需；与 production.health_token 二选一）
# curl -H "Authorization: Bearer $HEALTH_CHECK_TOKEN" http://127.0.0.1:8080/ready
HEALTH_CHECK_TOKEN=your-random-token-here

# 营业时间
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=23:00

# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO
